{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  // src/worker is Workers-only (cloudflare:workers, KVNamespace) and is built
  // by wrangler, not tsc. Typecheck it with tsconfig.worker.json.
  //
  // src/apps/ui is browser code bundled by scripts/build-apps.mjs and needs the
  // DOM lib, which the server build deliberately does not have. Typecheck it
  // with src/apps/ui/tsconfig.json (npm run typecheck:apps).
  "exclude": ["node_modules", "dist", "src/worker", "src/apps/ui"]
}
